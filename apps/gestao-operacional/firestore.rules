rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email));
    }

    // Exige nao so estar logado, mas ter um perfil ativo cadastrado por um
    // admin. Sem isso, uma conta criada direto pela API do Firebase (sem
    // nunca passar pelo app) ficaria "logada" pra sempre sem nenhum
    // perfil, e isSignedIn() sozinho já liberaria dados do hotel.
    function isActiveUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
        userDoc().data.active == true;
    }

    function isAdmin() {
      return isActiveUser() && userDoc().data.role == 'ADMIN';
    }

    // Colaborador ativo com o modulo liberado no proprio cadastro (mesma
    // lista de permissoes que já controla o menu do app), ou admin.
    function hasModule(module) {
      return isAdmin() || (isActiveUser() && module in userDoc().data.permissions);
    }

    match /users/{email} {
      // Cada pessoa le o proprio perfil; admins leem qualquer um (equipe).
      allow read: if isSignedIn() && (request.auth.token.email == email || isAdmin());

      // Bootstrap: o dono do hotel pode criar o PROPRIO perfil como ADMIN
      // uma unica vez, quando o documento ainda nao existe (create, nao
      // update). Depois disso, so admins ja cadastrados podem criar novos
      // perfis de equipe.
      allow create: if isSignedIn() && request.auth.token.email == email && (
        (email == 'mateus.orezende@gmail.com' && request.resource.data.role == 'ADMIN') ||
        isAdmin()
      );

      allow update, delete: if isAdmin();
    }

    // Dados operacionais (quartos, estoque, manutencao): exige perfil ativo
    // E o modulo correspondente liberado (mesma lista de permissoes que já
    // controla o menu do app) — nao só estar logado. Exclusão sempre restrita
    // a admin, pra ninguém apagar histórico/estoque/manutenção por engano
    // ou má-fé.
    match /rooms/{roomId} {
      allow read, create, update: if hasModule('rooms');
      allow delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read, create, update: if hasModule('inventory');
      allow delete: if isAdmin();
    }

    match /manutencao_ambientes/{ambienteId} {
      allow read, create, update: if hasModule('maintenance');
      allow delete: if isAdmin();
    }

    match /manutencao_registros/{registroId} {
      allow read, create, update: if hasModule('maintenance');
      allow delete: if isAdmin();
    }
  }
}
