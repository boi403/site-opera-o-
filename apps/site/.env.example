GEMINI_API_KEY=coloque_a_chave_apenas_no_servidor
AI_PORT=3001
ALLOWED_ORIGINS=http://localhost:3000
AI_PROXY_TARGET=http://localhost:3001
VITE_AI_API_URL=
# Google Sign-In (OAuth Client ID obtido no Google Cloud Console)
# As duas variaveis devem ter o MESMO valor: uma para o frontend (Vite), outra
# para o servidor validar a assinatura do token (nunca confie em e-mail vindo do cliente).
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
ADMIN_LOGIN_NAME=Admin Araguaia
ADMIN_LOGIN_EMAIL=admin@palacioaraguaia.com
ADMIN_LOGIN_PASSWORD=troque_para_uma_senha_forte
ADMIN_SESSION_TTL_MS=28800000
# Opcional: configure varios usuarios em JSON e ignore ADMIN_LOGIN_*.
# ADMIN_USERS_JSON=[{"name":"Admin Araguaia","email":"admin@palacioaraguaia.com","password":"senha_forte","active":true}]

